# Copy to .env and adjust for your execution context.
# No real secrets are required: all services use demo defaults.

# Kafka bootstrap servers.
#   Host run (python3 spark_stream.py):  localhost:9092
#   Inside Docker network (DAG, spark-streaming service): broker:29092
KAFKA_HOST=localhost:9092

# Cassandra contact point.
#   Host run: localhost
#   Inside Docker network: cassandra
CASSANDRA_HOST=localhost

# Spark master for the streaming job.
#   Host run: local[*]
#   Docker Compose cluster: spark://spark-master:7077
SPARK_MASTER_URL=local[*]

# Spark Structured Streaming checkpoint directory.
# Inside Docker it is backed by the spark_checkpoints volume.
CHECKPOINT_DIR=/tmp/checkpoint

# Demo credentials for local UIs (never reuse in real environments).
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
